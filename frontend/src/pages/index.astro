---
import Layout from "../layouts/layout.astro";
import TaskFormIsland from "../components/TaskForm";
---

<Layout title="Task Tracker">
  <div id="app-root">
    <p id="loading">Loading tasks...</p>
    <div id="task-groups" style="display: none;">
      <section>
        <h2>Overdue</h2>
        <ul id="group-overdue"></ul>
      </section>
      <section>
        <h2>Hari Ini</h2>
        <ul id="group-today"></ul>
      </section>
      <section>
        <h2>Akan Datang</h2>
        <ul id="group-upcoming"></ul>
      </section>
      <section>
        <h2>Tanpa Deadline</h2>
        <ul id="group-no-deadline"></ul>
      </section>
    </div>
  </div>

  <TaskFormIsland client:load />
</Layout>

<script>
  import { getTasks, updateTaskStatus, type Task } from "../lib/api";
  import { requireAuth } from "../lib/auth";

  const token = requireAuth();

  function groupTasks(tasks: Task[]) {
    const today = new Date().toISOString().split("T")[0];
    const groups: Record<string, Task[]> = {
      overdue: [],
      today: [],
      upcoming: [],
      "no-deadline": [],
    };

    for (const task of tasks) {
      if (!task.due_date) groups["no-deadline"].push(task);
      else if (task.due_date < today) groups.overdue.push(task);
      else if (task.due_date === today) groups.today.push(task);
      else groups.upcoming.push(task);
    }
    return groups;
  }

  function renderTask(task: Task): string {
    return `
      <li data-id="${task.id}">
        <input type="checkbox" ${task.status === "done" ? "checked" : ""} />
        <span>${task.title}</span>
        ${task.due_date ? `<small>${task.due_date}</small>` : ""}
      </li>
    `;
  }

  async function loadTasks() {
    const loadingEl = document.getElementById("loading")!;
    const groupsEl = document.getElementById("task-groups")!;

    try {
      const { data } = await getTasks(token);
      const groups = groupTasks(data);

      document.getElementById("group-overdue")!.innerHTML = groups.overdue.map(renderTask).join("");
      document.getElementById("group-today")!.innerHTML = groups.today.map(renderTask).join("");
      document.getElementById("group-upcoming")!.innerHTML = groups.upcoming.map(renderTask).join("");
      document.getElementById("group-no-deadline")!.innerHTML = groups["no-deadline"].map(renderTask).join("");

      loadingEl.style.display = "none";
      groupsEl.style.display = "block";

      attachCheckboxListeners();
    } catch (err) {
      loadingEl.textContent = "Gagal memuat task. Backend mungkin baru bangun dari sleep, coba refresh dalam beberapa detik.";
    }
  }

  function attachCheckboxListeners() {
    document.querySelectorAll<HTMLInputElement>("#task-groups input[type=checkbox]").forEach((checkbox) => {
      checkbox.addEventListener("change", async (e) => {
        const li = (e.target as HTMLElement).closest("li")!;
        const id = Number(li.dataset.id);
        const newStatus = checkbox.checked ? "done" : "todo";
        await updateTaskStatus(token, id, newStatus);
        loadTasks();
      });
    });
  }

  loadTasks();
  window.addEventListener("task-created", loadTasks);
</script>